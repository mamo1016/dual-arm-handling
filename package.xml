<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dual_arm</name>
  <version>0.1.0</version>
  <description>Dual-arm 7-DOF manipulation demo in ROS 2: inverse kinematics,
    singularity-robust Cartesian control, and a bimanual "hot potato" handoff.</description>
  <maintainer email="27567543+mamo1016@users.noreply.github.com">Mamoru Ueda</maintainer>
  <license>Apache-2.0</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- Robot meshes: the open-source OpenArm description package. -->
  <exec_depend>openarm_description</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
